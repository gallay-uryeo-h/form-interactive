{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "admin",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "server.js",
        "package.json",
        "README.md",
        "stitch-raw/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|html|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "mobile",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "server.js",
        "package.json",
        "README.md",
        "stitch-raw/**",
        "home.html",
        "admin.html",
        "dashboard.html",
        "index.html"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/mobile.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|html|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}

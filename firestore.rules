rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /form-interactive/{docId} {
      // 메타데이터 문서는 로그인한 사용자 누구나 읽기 가능
      allow read: if docId == "metadata" && request.auth != null;
      
      // _admins 문서: 로그인한 사용자 읽기 가능, 쓰기는 어드민만
      allow read: if docId == "_admins" && request.auth != null;
      allow write: if docId == "_admins" && isAdmin();
      
      // task 문서: 로그인한 사용자 읽기/생성 가능 (시트 내 카드 추가 지원)
      // 수정 및 삭제는 어드민 또는 해당 사용자
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null && isOwnRow());
      allow delete: if isAdmin() || (request.auth != null && isOwnRow());
    }
    
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == "gallay@uryeo-h.gne.go.kr" ||
          (
            exists(/databases/$(database)/documents/form-interactive/_admins) &&
            request.auth.token.email.lower() in get(/databases/$(database)/documents/form-interactive/_admins).data.emails
          )
        );
    }
    
    function isOwnRow() {
      // 행 업데이트/삭제: 로그인한 사용자
      return resource != null;
    }
  }
}

